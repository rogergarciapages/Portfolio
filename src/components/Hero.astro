---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<section id="about" class="relative pt-12 pb-16 md:pt-20 md:pb-24 border-b border-swiss-border overflow-hidden">
  <!-- Subtle architectural background grid -->
  <div class="absolute inset-0 swiss-grid-pattern opacity-60 pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Relocation & Permit Alert Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-blue-50/80 border border-blue-200/80 text-swiss-blue text-xs font-mono font-medium mb-8">
      <span class="inline-block w-2 h-2 rounded-full bg-swiss-blue animate-pulse"></span>
      <span>{t.hero.logisticsBadge}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      
      <!-- Left Column: Bio & Core Pitch -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        
        <p class="font-mono text-sm tracking-wider text-swiss-muted uppercase mb-3">
          {t.hero.greeting}
        </p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-swiss-primary tracking-tighter leading-none mb-4">
          {t.hero.name}
        </h1>

        <div class="inline-block mb-6">
          <p class="text-lg sm:text-xl font-semibold text-swiss-blue leading-snug">
            {t.hero.headline}
          </p>
        </div>

        <p class="text-base sm:text-lg text-swiss-secondary leading-relaxed mb-8 max-w-2xl">
          {t.hero.bio}
        </p>

        <!-- CTAs: Télécharger CV (PDF) & Me Contacter -->
        <div class="flex flex-wrap items-center gap-4 mb-10">
          <a
            href="#cv"
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded text-white bg-swiss-blue hover:bg-swiss-blue-hover shadow-swiss-card transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-swiss-blue focus:ring-offset-2"
          >
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            {t.hero.ctaCV}
          </a>

          <a
            href="#contact"
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded text-swiss-primary bg-white hover:bg-neutral-50 border border-swiss-border hover:border-swiss-border-hover shadow-swiss-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-swiss-primary focus:ring-offset-2"
          >
            <svg class="w-4 h-4 mr-2 text-swiss-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {t.hero.ctaContact}
          </a>
        </div>

        <!-- Direct Reach Links -->
        <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-swiss-border/80 text-xs font-mono text-swiss-secondary">
          <a
            href="mailto:roger.garcia75@gmail.com"
            class="flex items-center gap-1.5 hover:text-swiss-blue transition-colors"
            aria-label={t.hero.emailAria}
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            roger.garcia75@gmail.com
          </a>

          <a
            href="tel:+34646869653"
            class="hover:text-swiss-blue transition-colors"
            aria-label={t.hero.callAria}
          >
            +34 646 86 96 53
          </a>

          <div class="flex items-center gap-3 ml-auto">
            <a
              href="https://github.com/rogergarciapages"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-swiss-blue transition-colors"
              aria-label={t.hero.githubAria}
            >
              GitHub ↗
            </a>
            <span class="text-neutral-300">·</span>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-swiss-blue transition-colors"
              aria-label={t.hero.linkedinAria}
            >
              LinkedIn ↗
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Framed Portrait & Status Indicator -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-end">
        <div class="relative w-full max-w-sm">
          
          <!-- Portrait Container with Swiss Architectural Frame -->
          <div class="relative p-2 bg-white rounded-xl border border-swiss-border shadow-swiss-card">
            <div class="relative aspect-square w-full rounded-lg overflow-hidden bg-neutral-100">
              <img
                src="/images/roger-profile.jpg"
                alt="Roger Garcia Pagès - Ingénieur Systèmes & Automatisation"
                class="w-full h-full object-cover object-center filter contrast-[1.03]"
                loading="eager"
                width="400"
                height="400"
              />
            </div>

            <!-- Floating Status Indicator Badge -->
            <div class="mt-3 px-3 py-2 bg-neutral-50 rounded border border-swiss-border flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                </span>
                <span class="font-medium text-swiss-primary">
                  {t.hero.statusIndicator}
                </span>
              </div>
              <span class="text-[10px] font-mono text-swiss-muted uppercase">
                CH · 2027
              </span>
            </div>
          </div>

          <!-- Micro Metric Highlights -->
          <div class="grid grid-cols-3 gap-2 mt-4">
            <div class="bg-white p-3 rounded-lg border border-swiss-border text-center shadow-swiss-sm">
              <div class="text-xl font-bold font-mono text-swiss-primary">
                {t.hero.stats.expYears}
              </div>
              <div class="text-[10px] text-swiss-muted uppercase tracking-tight mt-0.5">
                {t.hero.stats.expLabel}
              </div>
            </div>

            <div class="bg-white p-3 rounded-lg border border-swiss-border text-center shadow-swiss-sm">
              <div class="text-xl font-bold font-mono text-swiss-blue">
                {t.hero.stats.automationImpact}
              </div>
              <div class="text-[10px] text-swiss-muted uppercase tracking-tight mt-0.5">
                {t.hero.stats.automationLabel}
              </div>
            </div>

            <div class="bg-white p-3 rounded-lg border border-swiss-border text-center shadow-swiss-sm">
              <div class="text-xl font-bold font-mono text-swiss-primary">
                {t.hero.stats.legalSupport}
              </div>
              <div class="text-[10px] text-swiss-muted uppercase tracking-tight mt-0.5">
                {t.hero.stats.legalLabel}
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
