---
import { PROFILES, PASSWORDS } from '../i18n/profiles';
import type { Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- Password Gate Overlay -->
<div
  id="password-gate-overlay"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/80 dark:bg-black/85 backdrop-blur-md transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gate-title"
>
  <div class="relative w-full max-w-md bg-white dark:bg-slate-900 border border-swiss-border dark:border-slate-800 rounded-2xl shadow-2xl p-6 sm:p-8 overflow-hidden">
    
    <!-- Left Accent Stripe -->
    <div class="absolute left-0 top-0 bottom-0 w-2 bg-swiss-blue dark:bg-sky-500"></div>

    <!-- Icon & Sub-badge -->
    <div class="flex items-center justify-between mb-6 pl-2">
      <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-sky-950/70 border border-blue-200 dark:border-sky-800 flex items-center justify-center text-swiss-blue dark:text-sky-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <span class="text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded bg-neutral-100 dark:bg-slate-800 text-swiss-muted dark:text-slate-400 border border-swiss-border dark:border-slate-700">
        Accès Réservé Recruteurs
      </span>
    </div>

    <!-- Header Content -->
    <div class="pl-2 mb-6">
      <h2 id="gate-title" class="text-xl font-bold tracking-tight text-swiss-primary dark:text-white mb-2">
        {locale === 'fr' ? 'Accès au Profil Candidat' : 'Candidate Profile Access'}
      </h2>
      <p class="text-xs sm:text-sm text-swiss-secondary dark:text-slate-400 leading-relaxed">
        {locale === 'fr' 
          ? 'Ce profil est configuré sur-mesure. Veuillez saisir le mot de passe indiqué dans ma lettre de motivation pour déverrouiller le dossier adapté à votre poste.' 
          : 'This profile is tailored to your requirements. Please enter the access password provided in my cover letter to unlock the relevant profile.'}
      </p>
    </div>

    <!-- Form -->
    <form id="gate-form" class="pl-2 space-y-4">
      <div>
        <label for="gate-password-input" class="block text-xs font-mono font-semibold text-swiss-primary dark:text-slate-300 uppercase tracking-wider mb-2">
          {locale === 'fr' ? 'Mot de passe d\'accès' : 'Access Password'}
        </label>
        <div class="relative">
          <input
            id="gate-password-input"
            type="password"
            autocomplete="off"
            required
            placeholder="••••"
            class="w-full px-4 py-3 text-center text-lg tracking-widest font-mono rounded-xl bg-neutral-50 dark:bg-slate-800/80 border border-swiss-border dark:border-slate-700 text-swiss-primary dark:text-white placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-swiss-blue dark:focus:ring-sky-500 transition-all"
          />
        </div>
        <p id="gate-error-msg" class="hidden mt-2 text-xs font-medium text-red-600 dark:text-red-400 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span id="gate-error-text">
            {locale === 'fr' ? 'Mot de passe non reconnu. Vérifiez le code fourni.' : 'Unrecognized password. Please check the code provided.'}
          </span>
        </p>
      </div>

      <button
        type="submit"
        id="gate-submit-btn"
        class="w-full inline-flex items-center justify-center px-5 py-3 text-sm font-semibold rounded-xl text-white bg-swiss-blue hover:bg-swiss-blue-hover dark:bg-sky-600 dark:hover:bg-sky-500 shadow-swiss-card transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-swiss-blue focus:ring-offset-2"
      >
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
        </svg>
        {locale === 'fr' ? 'Déverrouiller le profil' : 'Unlock Profile'}
      </button>

      <div class="pt-2 text-center">
        <span class="text-[11px] font-mono text-swiss-muted dark:text-slate-500">
          Genève · Lausanne · Vaud (2027)
        </span>
      </div>
    </form>

  </div>
</div>

<script define:vars={{ PASSWORDS, PROFILES, locale }}>
  const overlay = document.getElementById('password-gate-overlay');
  const form = document.getElementById('gate-form');
  const input = document.getElementById('gate-password-input');
  const errorMsg = document.getElementById('gate-error-msg');
  const errorText = document.getElementById('gate-error-text');

  // Check URL query parameters for stealth instant unlock (?code=XXXX)
  const urlParams = new URLSearchParams(window.location.search);
  const codeParam = urlParams.get('code') || urlParams.get('pwd') || urlParams.get('p');
  
  if (codeParam) {
    const matchedProfile = PASSWORDS[codeParam.trim().toLowerCase()];
    if (matchedProfile) {
      sessionStorage.setItem('rgp_profile', matchedProfile);
      // Clean URL silently without refresh, leaving zero trace in browser history
      window.history.replaceState({}, '', window.location.pathname);
    }
  }

  // Check current session state
  const currentProfile = sessionStorage.getItem('rgp_profile');

  if (currentProfile && PROFILES[currentProfile]) {
    applyProfile(currentProfile, false);
  } else {
    lockGate();
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const entered = (input?.value || '').trim().toLowerCase();
    const matched = PASSWORDS[entered];

    if (matched && PROFILES[matched]) {
      sessionStorage.setItem('rgp_profile', matched);
      errorMsg?.classList.add('hidden');
      applyProfile(matched, true);
    } else {
      errorMsg?.classList.remove('hidden');
      input?.classList.add('border-red-500', 'focus:ring-red-500');
      input?.focus();
    }
  });

  function lockGate() {
    overlay?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    setTimeout(() => input?.focus(), 150);
  }

  function unlockGate() {
    overlay?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  function applyProfile(profileKey, animate) {
    const profile = PROFILES[profileKey];
    if (!profile) return;

    unlockGate();

    // 1. Headline
    const headlineEl = document.querySelector('[data-profile-headline]');
    if (headlineEl) {
      headlineEl.textContent = profile.headline[locale];
    }

    // 2. Bio
    const bioEl = document.querySelector('[data-profile-bio]');
    if (bioEl) {
      bioEl.textContent = profile.bio[locale];
    }

    // 3. Stats
    const s1Val = document.querySelector('[data-profile-s1-val]');
    const s1Lbl = document.querySelector('[data-profile-s1-lbl]');
    if (s1Val) s1Val.textContent = profile.stats.stat1.val;
    if (s1Lbl) s1Lbl.textContent = profile.stats.stat1[locale];

    const s2Val = document.querySelector('[data-profile-s2-val]');
    const s2Lbl = document.querySelector('[data-profile-s2-lbl]');
    if (s2Val) s2Val.textContent = profile.stats.stat2.val;
    if (s2Lbl) s2Lbl.textContent = profile.stats.stat2[locale];

    const s3Val = document.querySelector('[data-profile-s3-val]');
    const s3Lbl = document.querySelector('[data-profile-s3-lbl]');
    if (s3Val) s3Val.textContent = profile.stats.stat3.val;
    if (s3Lbl) s3Lbl.textContent = profile.stats.stat3[locale];

    // 4. Primary Hero CV button
    const heroCvBtn = document.querySelector('[data-profile-hero-cv]');
    if (heroCvBtn) {
      heroCvBtn.setAttribute('href', profile.primaryCV.file);
      heroCvBtn.setAttribute('download', '');
      const span = heroCvBtn.querySelector('.cv-label');
      if (span) {
        span.textContent = locale === 'fr' ? profile.primaryCV.frName : profile.primaryCV.enName;
      }
    }

    // 5. Active Profile Navbar Pill
    const navPill = document.getElementById('navbar-profile-pill');
    const navPillText = document.getElementById('navbar-profile-pill-text');
    if (navPill && navPillText) {
      navPill.classList.remove('hidden');
      navPillText.textContent = profile.badge[locale];
    }

    // Dispatch global event
    window.dispatchEvent(new CustomEvent('rgp-profile-activated', { detail: { profile: profileKey } }));
  }

  // Global listener to re-lock / switch password
  window.addEventListener('rgp-relock', () => {
    sessionStorage.removeItem('rgp_profile');
    if (input) input.value = '';
    errorMsg?.classList.add('hidden');
    const navPill = document.getElementById('navbar-profile-pill');
    navPill?.classList.add('hidden');
    lockGate();
  });
</script>
