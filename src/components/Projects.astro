---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<section id="projects" class="py-16 md:py-24 border-b border-swiss-border bg-swiss-bg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-block px-2.5 py-1 rounded bg-neutral-100 border border-swiss-border text-swiss-secondary font-mono text-xs uppercase tracking-wider mb-3">
        {t.projects.sectionBadge}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-swiss-primary tracking-tight">
        {t.projects.title}
      </h2>
      <p class="mt-2 text-base text-swiss-secondary">
        {t.projects.subtitle}
      </p>
    </div>

    <!-- 3-Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.projects.items.map((project) => (
        <article class="bg-swiss-surface rounded-xl border border-swiss-border card-hover flex flex-col justify-between p-6 sm:p-7 shadow-swiss-card">
          <div>
            <!-- Category and GitHub Action -->
            <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-neutral-100">
              <span class="font-mono text-xs font-semibold text-swiss-blue tracking-wide uppercase">
                {project.category}
              </span>
              <a
                href={project.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-xs font-mono text-swiss-secondary hover:text-swiss-blue transition-colors group"
                aria-label={`${t.projects.viewOnGithub} - ${project.title}`}
              >
                <span>GitHub</span>
                <svg class="w-3.5 h-3.5 ml-1 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <!-- Project Title -->
            <h3 class="text-lg font-bold text-swiss-primary tracking-tight mb-3">
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-swiss-blue transition-colors">
                {project.title}
              </a>
            </h3>

            <!-- Project Description -->
            <p class="text-sm text-swiss-secondary leading-relaxed mb-6">
              {project.description}
            </p>
          </div>

          <div>
            <!-- Business/Engineering Impact Note -->
            <div class="mb-5 p-3 rounded bg-neutral-50 border border-neutral-200/80 text-xs font-sans text-swiss-primary">
              <span class="font-semibold text-swiss-blue font-mono">Impact :</span> {project.impact}
            </div>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-neutral-100">
              {project.tags.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-neutral-100 text-swiss-secondary border border-swiss-border/60">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Self-hosted Analytics Showcase Banner -->
    <div class="mt-10 p-5 rounded-xl bg-white border border-swiss-border shadow-swiss-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center text-swiss-blue flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-mono font-bold text-swiss-primary uppercase tracking-wider">
            {t.projects.analyticsBannerTitle}
          </h4>
          <p class="text-xs text-swiss-secondary mt-0.5">
            {t.projects.analyticsBannerText}
          </p>
        </div>
      </div>
      
      <div class="flex items-center gap-2 font-mono text-xs text-swiss-muted flex-shrink-0">
        <span class="px-2 py-1 rounded bg-neutral-100 border border-swiss-border">umami-fork</span>
        <span class="px-2 py-1 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">Zero Cookies</span>
      </div>
    </div>

  </div>
</section>
