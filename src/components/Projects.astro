---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<section id="projects" class="py-16 md:py-24 border-b border-swiss-border dark:border-slate-800 bg-swiss-bg dark:bg-[#0B0F19] transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-block px-2.5 py-1 rounded bg-neutral-100 dark:bg-slate-800 border border-swiss-border dark:border-slate-700 text-swiss-secondary dark:text-slate-300 font-mono text-xs uppercase tracking-wider mb-3">
        {t.projects.sectionBadge}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-swiss-primary dark:text-white tracking-tight">
        {t.projects.title}
      </h2>
      <p class="mt-2 text-base text-swiss-secondary dark:text-slate-300">
        {t.projects.subtitle}
      </p>
    </div>

    <!-- 3-Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.projects.items.map((project) => (
        <article class="bg-swiss-surface dark:bg-slate-900 rounded-xl border border-swiss-border dark:border-slate-800 card-hover flex flex-col justify-between p-6 sm:p-7 shadow-swiss-card">
          <div>
            <!-- Category and GitHub Action -->
            <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-neutral-100 dark:border-slate-800">
              <span class="font-mono text-xs font-semibold text-swiss-blue dark:text-sky-400 tracking-wide uppercase">
                {project.category}
              </span>
              <a
                href={project.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-xs font-mono text-swiss-secondary dark:text-slate-400 hover:text-swiss-blue dark:hover:text-sky-400 transition-colors group"
                aria-label={`${t.projects.viewOnGithub} - ${project.title}`}
              >
                <span>GitHub</span>
                <svg class="w-3.5 h-3.5 ml-1 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <!-- Project Title -->
            <h3 class="text-lg font-bold text-swiss-primary dark:text-white tracking-tight mb-3">
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-swiss-blue dark:hover:text-sky-400 transition-colors">
                {project.title}
              </a>
            </h3>

            <!-- Project Description -->
            <p class="text-sm text-swiss-secondary dark:text-slate-300 leading-relaxed mb-6">
              {project.description}
            </p>
          </div>

          <div>
            <!-- Business/Engineering Impact Note -->
            <div class="mb-5 p-3 rounded bg-neutral-50 dark:bg-slate-800/80 border border-neutral-200/80 dark:border-slate-750 text-xs font-sans text-swiss-primary dark:text-slate-200">
              <span class="font-semibold text-swiss-blue dark:text-sky-400 font-mono">Impact&nbsp;:</span> {project.impact}
            </div>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-neutral-100 dark:border-slate-800">
              {project.tags.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-neutral-100 dark:bg-slate-800 text-swiss-secondary dark:text-slate-300 border border-swiss-border/60 dark:border-slate-700">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Self-hosted Analytics Showcase Banner -->
    <div class="mt-10 p-5 rounded-xl bg-white dark:bg-slate-900 border border-swiss-border dark:border-slate-800 shadow-swiss-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-sky-950/70 border border-blue-200 dark:border-sky-800 flex items-center justify-center text-swiss-blue dark:text-sky-400 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-mono font-bold text-swiss-primary dark:text-white uppercase tracking-wider">
            {t.projects.analyticsBannerTitle}
          </h4>
          <p class="text-xs text-swiss-secondary dark:text-slate-400 mt-0.5">
            {t.projects.analyticsBannerText}
          </p>
        </div>
      </div>
      
      <div class="flex items-center gap-2 font-mono text-xs text-swiss-muted dark:text-slate-400 flex-shrink-0">
        <span class="px-2 py-1 rounded bg-neutral-100 dark:bg-slate-800 border border-swiss-border dark:border-slate-700">umami-fork</span>
        <span class="px-2 py-1 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">Zero Cookies</span>
      </div>
    </div>

  </div>
</section>
