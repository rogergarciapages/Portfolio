---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<section id="cv" class="py-16 md:py-24 border-b border-swiss-border bg-swiss-bg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-block px-2.5 py-1 rounded bg-neutral-100 border border-swiss-border text-swiss-secondary font-mono text-xs uppercase tracking-wider mb-3">
        {t.cvCenter.sectionBadge}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-swiss-primary tracking-tight">
        {t.cvCenter.title}
      </h2>
      <p class="mt-2 text-base text-swiss-secondary">
        {t.cvCenter.subtitle}
      </p>
    </div>

    <!-- 3 Tailored Download Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.cvCenter.cards.map((cv, index) => (
        <div class="bg-white rounded-xl border border-swiss-border card-hover flex flex-col justify-between p-6 sm:p-7 shadow-swiss-card">
          
          <div>
            <!-- Top Tag and Format Badge -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-neutral-100 text-swiss-primary border border-swiss-border">
                {cv.tag}
              </span>
              <span class="inline-flex items-center gap-1 font-mono text-xs text-swiss-muted">
                <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                </svg>
                PDF · A4
              </span>
            </div>

            <!-- Card Title -->
            <h3 class="text-lg font-bold text-swiss-primary tracking-tight mb-3 leading-snug">
              {cv.title}
            </h3>

            <!-- Role Fit Summary -->
            <p class="text-xs text-swiss-secondary leading-relaxed mb-4">
              {cv.summary}
            </p>

            <!-- Key Competencies Box -->
            <div class="p-3 rounded bg-neutral-50 border border-neutral-200/80 mb-6 text-xs leading-normal">
              <div class="font-mono font-semibold text-swiss-primary mb-1">
                {cv.focusLabel}
              </div>
              <div class="text-swiss-secondary font-mono text-[11px]">
                {cv.focus}
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-2 pt-4 border-t border-neutral-100">
            <a
              href={cv.file}
              download
              class="w-full inline-flex items-center justify-center px-4 py-2.5 text-xs font-semibold rounded text-white bg-swiss-blue hover:bg-swiss-blue-hover shadow-swiss-sm transition-colors focus:outline-none focus:ring-2 focus:ring-swiss-blue focus:ring-offset-2"
            >
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              {t.cvCenter.downloadButton}
            </a>

            <a
              href={cv.file}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center px-4 py-2 text-xs font-medium rounded text-swiss-secondary hover:text-swiss-primary bg-neutral-50 hover:bg-neutral-100 border border-swiss-border transition-colors"
            >
              <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              {t.cvCenter.previewButton}
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
